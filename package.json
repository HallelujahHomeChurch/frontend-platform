{
  "name": "hhc-frontend-platform",
  "version": "1.1.3",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@4.2.0": "4.3.2",
      "undici@7.29.0": "7.29.1",
      "brace-expansion@2.1.4": "2.1.7",
      "brace-expansion@5.0.9": "5.0.12",
      "source-map-js@1.2.1": "1.2.2"
    }
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "vite": "8.1.6"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "pretest": "pnpm --filter @hallelujahhomechurch/account-client build && pnpm --filter @hallelujahhomechurch/donation-ui^... build",
    "test": "pnpm -r --if-present test:run",
    "check:packages": "pnpm --filter @hallelujahhomechurch/hhc-web-client exec tsc -p tsconfig.locale-contract.json && node scripts/check-package-contracts.mjs",
    "pack:packages": "node scripts/pack-packages.mjs",
    "test:consumers": "node scripts/test-packed-consumers.mjs"
  }
}
