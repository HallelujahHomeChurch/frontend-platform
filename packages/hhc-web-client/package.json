{
  "name": "@hallelujahhomechurch/hhc-web-client",
  "version": "0.6.21",
  "license": "UNLICENSED",
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HallelujahHomeChurch/frontend-platform.git",
    "directory": "packages/hhc-web-client"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "openapi-typescript openapi/hhc-web-api.yaml -o src/generated.ts",
    "check:generated": "pnpm generate && git diff --exit-code -- src/generated.ts",
    "lint": "oxlint src",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.15.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.10.1",
    "oxlint": "^1.71.0",
    "typescript": "catalog:codegen",
    "vitest": "catalog:"
  }
}
