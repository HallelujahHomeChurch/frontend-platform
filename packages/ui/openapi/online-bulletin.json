{
  "openapi": "3.1.0",
  "info": {
    "title": "Weekly bulletin domain",
    "version": "1"
  },
  "paths": {},
  "components": {
    "schemas": {
      "OnlineBulletinID": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,128}$"
      },
      "OnlineBulletinHash": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "OnlineBulletinFontRole": {
        "type": "string",
        "enum": [
          "body",
          "scripture",
          "emphasis",
          "reference",
          "foreignText"
        ]
      },
      "OnlineBulletinDocument": {
        "description": "Typed immutable content. Canonical issue metadata and mutable source asset IDs are intentionally absent. Maximum encoded size is 8 MiB; server also validates references, total collection limits and fragment coverage.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issueId",
          "series",
          "contentLocale",
          "schemaVersion",
          "templateVersion",
          "sourceAssetChecksum",
          "sourcePageCount",
          "pages",
          "layoutManifest",
          "components"
        ],
        "properties": {
          "issueId": {
            "type": "string",
            "format": "uuid"
          },
          "series": {
            "type": "string",
            "const": "general"
          },
          "contentLocale": {
            "type": "string",
            "const": "zh-Hant"
          },
          "schemaVersion": {
            "type": "string",
            "const": "1"
          },
          "templateVersion": {
            "type": "string",
            "const": "v1"
          },
          "sourceAssetChecksum": {
            "$ref": "#/components/schemas/OnlineBulletinHash"
          },
          "sourcePageCount": {
            "type": "integer",
            "minimum": 4,
            "maximum": 40
          },
          "pages": {
            "type": "array",
            "minItems": 4,
            "maxItems": 80,
            "items": {
              "$ref": "#/components/schemas/OnlineBulletinPage"
            }
          },
          "layoutManifest": {
            "$ref": "#/components/schemas/OnlineBulletinLayoutManifest"
          },
          "components": {
            "type": "array",
            "minItems": 6,
            "maxItems": 256,
            "items": {
              "$ref": "#/components/schemas/OnlineBulletinComponent"
            }
          }
        }
      },
      "OnlineBulletinPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "width",
          "height"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OnlineBulletinID"
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 2000,
            "description": "PDF points."
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 2000,
            "description": "PDF points."
          }
        }
      },
      "OnlineBulletinBox": {
        "description": "Normalized page-relative rectangle. Server additionally rejects any edge exceeding the page boundary.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "properties": {
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      },
      "OnlineBulletinLayoutManifest": {
        "description": "Revision-owned manifest; hashes bind the authoritative isolated-worker measurement. Empty validation hashes represent a pending draft, never permission to publish.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "templateVersion",
          "rendererVersion",
          "rendererArtifactSha256",
          "assets",
          "pages"
        ],
        "properties": {
          "templateVersion": {
            "type": "string",
            "const": "v1"
          },
          "rendererVersion": {
            "type": "string",
            "const": "v1"
          },
          "rendererArtifactSha256": {
            "$ref": "#/components/schemas/OnlineBulletinHash"
          },
          "contentHash": {
            "$ref": "#/components/schemas/OnlineBulletinHash"
          },
          "layoutValidationHash": {
            "$ref": "#/components/schemas/OnlineBulletinHash"
          },
          "assets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "$ref": "#/components/schemas/OnlineBulletinAsset"
            }
          },
          "pages": {
            "type": "array",
            "minItems": 4,
            "maxItems": 80,
            "items": {
              "$ref": "#/components/schemas/OnlineBulletinLayoutPage"
            }
          }
        }
      },
      "OnlineBulletinAsset": {
        "description": "Code-owned permanent self-hosted asset, never an executable URL. Filename includes its exact SHA-256.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "sha256",
          "kind"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^/assets/weekly/v1/[a-zA-Z0-9_-]*[0-9a-f]{64}\\.(woff2|png|svg|webp)$"
          },
          "sha256": {
            "$ref": "#/components/schemas/OnlineBulletinHash"
          },
          "kind": {
            "type": "string",
            "enum": [
              "font",
              "decoration"
            ]
          },
          "fontRole": {
            "$ref": "#/components/schemas/OnlineBulletinFontRole"
          }
        }
      },
      "OnlineBulletinLayoutPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pageId",
          "slots"
        ],
        "properties": {
          "pageId": {
            "$ref": "#/components/schemas/OnlineBulletinID"
          },
          "fixedSlots": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "$ref": "#/components/schemas/OnlineBulletinFixedSlot"
            }
          },
          "slots": {
            "type": "array",
            "maxItems": 50000,
            "items": {
              "$ref": "#/components/schemas/OnlineBulletinSlot"
            }
          }
        }
      },
      "OnlineBulletinSlot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "componentId",
          "blockId",
          "box",
          "fragments"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OnlineBulletinID"
          },
          "componentId": {
            "$ref": "#/components/schemas/OnlineBulletinID"
          },
          "blockId": {
            "$ref": "#/components/schemas/OnlineBulletinID"
          },
          "box": {
            "$ref": "#/components/schemas/OnlineBulletinBox"
          },
          "continuationOf": {
            "$ref": "#/components/schemas/OnlineBulletinID"
          },
          "fragments": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "items": {
              "$ref": "#/components/schemas/OnlineBulletinFragment"
            }
          }
        }
      },
      "OnlineBulletinFixedSlot": {
        "description": "Template-owned geometry for a fixed label or canonical metadata reference. It contains no editable text or executable URL.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "element",
          "box",
          "style"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OnlineBulletinID"
          },
          "element": {
            "type": "string",
            "enum": [
              "title",
              "subtitle",
              "date",
              "issueNumber",
              "pageNumber",
              "masthead",
              "vision",
              "pastor",
              "contact",
              "scanHint",
              "websiteQRLabel",
              "youtubeQRLabel",
              "streamQRLabel",
              "welcomeLabel",
              "worshipLabel",
              "workLabel",
              "wordLabel",
              "verseLabel",
              "hymnLabel",
              "summaryLabel",
              "announcementsLabel",
              "prayersLabel",
              "titleLabel",
              "speakerLabel",
              "transcriberLabel",
              "editorLabel",
              "authorLabel",
              "logo",
              "backgroundLogo",
              "websiteQR",
              "youtubeQR",
              "streamQR",
              "topRule",
              "footerRule",
              "summaryFrame",
              "announcementsFrame",
              "prayersFrame"
            ]
          },
          "box": {
            "$ref": "#/components/schemas/OnlineBulletinBox"
          },
          "style": {
            "$ref": "#/components/schemas/OnlineBulletinParagraphStyle"
          }
        }
      },
      "OnlineBulletinCanonicalMetadata": {
        "description": "Read-only snapshot of existing CMS fields, separate from editable document content.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "subtitle",
          "issueNumber",
          "date"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "subtitle": {
            "type": "string",
            "maxLength": 256
          },
          "issueNumber": {
            "type": "integer",
            "minimum": 1
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "OnlineBulletinFragment": {
        "description": "Half-open offsets in Unicode code points, not UTF-8 bytes or UTF-16 units. Coverage must be complete and non-overlapping in reading order.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sentenceId",
          "start",
          "end"
        ],
        "properties": {
          "sentenceId": {
            "$ref": "#/components/schemas/OnlineBulletinID"
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          },
          "end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          }
        }
      },
      "OnlineBulletinSpan": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "fontRole"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "fontRole": {
            "$ref": "#/components/schemas/OnlineBulletinFontRole"
          }
        }
      },
      "OnlineBulletinSentence": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "spans"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OnlineBulletinID"
          },
          "spans": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "$ref": "#/components/schemas/OnlineBulletinSpan"
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "page",
              "box"
            ],
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 40
              },
              "box": {
                "$ref": "#/components/schemas/OnlineBulletinBox"
              }
            }
          }
        }
      },
      "OnlineBulletinParagraphStyle": {
        "description": "Font size and line height in PDF points. Indents and spacing in em units; negative first-line indentation supports hanging paragraphs.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fontSize",
          "lineHeight",
          "indent",
          "firstLineIndent",
          "spaceBefore",
          "spaceAfter"
        ],
        "properties": {
          "fontSize": {
            "type": "number",
            "minimum": 6,
            "maximum": 96
          },
          "lineHeight": {
            "type": "number",
            "minimum": 6,
            "maximum": 192
          },
          "letterSpacing": {
            "type": "number",
            "minimum": -0.5,
            "maximum": 1,
            "description": "Explicit source tracking in em; omitted means zero. Never adjusted automatically to fit edits."
          },
          "align": {
            "type": "string",
            "enum": [
              "left",
              "center",
              "right",
              "justify"
            ]
          },
          "indent": {
            "type": "number",
            "minimum": 0,
            "maximum": 20
          },
          "firstLineIndent": {
            "type": "number",
            "minimum": -20,
            "maximum": 20
          },
          "spaceBefore": {
            "type": "number",
            "minimum": 0,
            "maximum": 20
          },
          "spaceAfter": {
            "type": "number",
            "minimum": 0,
            "maximum": 20
          }
        }
      },
      "OnlineBulletinBlock": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "style",
          "sentences"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OnlineBulletinID"
          },
          "style": {
            "$ref": "#/components/schemas/OnlineBulletinParagraphStyle"
          },
          "sentences": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "items": {
              "$ref": "#/components/schemas/OnlineBulletinSentence"
            }
          }
        }
      },
      "OnlineBulletinItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "blocks"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OnlineBulletinID"
          },
          "title": {
            "$ref": "#/components/schemas/OnlineBulletinBlock"
          },
          "blocks": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "$ref": "#/components/schemas/OnlineBulletinBlock"
            }
          }
        }
      },
      "OnlineBulletinCover": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "welcome",
          "worship",
          "work",
          "wordQuestions",
          "weeklyVerses"
        ],
        "properties": {
          "welcome": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "$ref": "#/components/schemas/OnlineBulletinBlock"
            }
          },
          "worship": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "$ref": "#/components/schemas/OnlineBulletinItem"
            }
          },
          "work": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "$ref": "#/components/schemas/OnlineBulletinItem"
            }
          },
          "wordQuestions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "$ref": "#/components/schemas/OnlineBulletinItem"
            }
          },
          "weeklyVerses": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "$ref": "#/components/schemas/OnlineBulletinBlock"
            }
          }
        }
      },
      "OnlineBulletinBodySection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "title",
          "blocks"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "sermon",
              "testimony",
              "teaching",
              "reflection",
              "unknown"
            ],
            "description": "Unknown creates a blocking review issue."
          },
          "title": {
            "$ref": "#/components/schemas/OnlineBulletinBlock"
          },
          "subtitle": {
            "$ref": "#/components/schemas/OnlineBulletinBlock"
          },
          "contributors": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "name"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "speaker",
                    "transcriber",
                    "editor",
                    "author"
                  ]
                },
                "name": {
                  "$ref": "#/components/schemas/OnlineBulletinBlock"
                }
              }
            }
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "$ref": "#/components/schemas/OnlineBulletinBlock"
            }
          }
        }
      },
      "OnlineBulletinHymnLyrics": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hymns"
        ],
        "properties": {
          "hymns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "sections"
              ],
              "properties": {
                "id": {
                  "$ref": "#/components/schemas/OnlineBulletinID"
                },
                "number": {
                  "$ref": "#/components/schemas/OnlineBulletinBlock"
                },
                "title": {
                  "$ref": "#/components/schemas/OnlineBulletinBlock"
                },
                "sourceLabel": {
                  "$ref": "#/components/schemas/OnlineBulletinBlock"
                },
                "sections": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "kind",
                      "lines"
                    ],
                    "properties": {
                      "id": {
                        "$ref": "#/components/schemas/OnlineBulletinID"
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "verse",
                          "chorus",
                          "bridge"
                        ]
                      },
                      "lines": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 4096,
                        "items": {
                          "$ref": "#/components/schemas/OnlineBulletinBlock"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "OnlineBulletinComponent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/OnlineBulletinCoverComponent"
          },
          {
            "$ref": "#/components/schemas/OnlineBulletinBodyComponent"
          },
          {
            "$ref": "#/components/schemas/OnlineBulletinHymnComponent"
          },
          {
            "$ref": "#/components/schemas/OnlineBulletinBackComponent"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "cover": "#/components/schemas/OnlineBulletinCoverComponent",
            "bodySection": "#/components/schemas/OnlineBulletinBodyComponent",
            "hymnLyrics": "#/components/schemas/OnlineBulletinHymnComponent",
            "backSummary": "#/components/schemas/OnlineBulletinBackComponent",
            "announcements": "#/components/schemas/OnlineBulletinBackComponent",
            "victoriesAndPrayers": "#/components/schemas/OnlineBulletinBackComponent"
          }
        }
      },
      "OnlineBulletinCoverComponent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "cover"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OnlineBulletinID"
          },
          "type": {
            "type": "string",
            "const": "cover"
          },
          "cover": {
            "$ref": "#/components/schemas/OnlineBulletinCover"
          }
        }
      },
      "OnlineBulletinBodyComponent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "bodySection"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OnlineBulletinID"
          },
          "type": {
            "type": "string",
            "const": "bodySection"
          },
          "bodySection": {
            "$ref": "#/components/schemas/OnlineBulletinBodySection"
          }
        }
      },
      "OnlineBulletinHymnComponent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "hymnLyrics"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OnlineBulletinID"
          },
          "type": {
            "type": "string",
            "const": "hymnLyrics"
          },
          "hymnLyrics": {
            "$ref": "#/components/schemas/OnlineBulletinHymnLyrics"
          }
        }
      },
      "OnlineBulletinBackComponent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "items"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OnlineBulletinID"
          },
          "type": {
            "type": "string",
            "enum": [
              "backSummary",
              "announcements",
              "victoriesAndPrayers"
            ]
          },
          "items": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "$ref": "#/components/schemas/OnlineBulletinItem"
            }
          }
        }
      }
    }
  }
}
